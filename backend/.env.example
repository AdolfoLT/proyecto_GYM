# Puerto (Railway asigna PORT automáticamente)
PORT=3000

# MySQL local. En Railway usa las referencias de su servicio MySQL:
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_USER=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Proyecto_GYM

# Seguridad: genera secretos aleatorios y privados. Mantén PIN_SECRET estable.
ADMIN_TOKEN=CAMBIA_ESTE_TOKEN_POR_UNO_LARGO_Y_ALEATORIO
PIN_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO

# Frontend publicado
APP_URL=https://frontend-frmi.vercel.app/
CORS_ORIGINS=https://proyectogym-zeta.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_HOST=

# Transferencias (opcional)
PAGO_TRANSFERENCIA=0
TRANSFERENCIA_DATOS=

# Marca (opcional)
GYM_NOMBRE=Apolo GYM
GYM_LEMA=Tu gimnasio en Puebla, en tres sucursales.
GYM_DESCRIPCION=
GYM_ACENTO=#F8D048
GYM_CIUDAD=Puebla
