# Puerto (Railway asigna PORT automáticamente)
PORT=3000

DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=Proyecto_GYM
APP_URL=https://frontend-frmi.vercel.app
CORS_ORIGINS=https://frontend-frmi.vercel.app


# Seguridad: genera secretos aleatorios y privados. Mantén PIN_SECRET estable.
ADMIN_TOKEN=admin123
PIN_SECRET=1234

# Frontend publicado
APP_URL=https://frontend-frmi.vercel.app
CORS_ORIGINS=https://frontend-frmi.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_HOST=

# Transferencias (opcional)
PAGO_TRANSFERENCIA=0
TRANSFERENCIA_DATOS=

# Marca (opcional)
GYM_NOMBRE=Apolo GYM
GYM_LEMA=Tu gimnasio en Puebla, en tres sucursales.
GYM_DESCRIPCION=Gimnasio Apolo, con más de 20 años de experiencia en Puebla, ofreciendo servicios de calidad y atención personalizada. Contamos con entrenadores certificados y programas adaptados a tus necesidades.
