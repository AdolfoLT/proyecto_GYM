# Puerto (Railway lo asigna automáticamente)
PORT=3000

# MySQL (local). En Railway puedes usar las variables MYSQLHOST, MYSQLPORT,
# MYSQLUSER, MYSQLPASSWORD y MYSQLDATABASE que proporciona el servicio MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Proyecto_GYM

# Seguridad: genera valores aleatorios largos y privados.
ADMIN_TOKEN=CAMBIA_ESTE_TOKEN_POR_UNO_LARGO_Y_ALEATORIO
PIN_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO

# Dominio del frontend publicado en Vercel, sin diagonal final.
APP_URL=http://localhost:5173
# Agrega aquí el dominio de Vercel y cualquier preview que usarás, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Stripe (opcional). Para pagos en línea configura ambas claves y el webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_HOST=

# Transferencias bancarias (opcional)
PAGO_TRANSFERENCIA=0
TRANSFERENCIA_DATOS=

# Datos de marca (opcionales)
GYM_NOMBRE=Apolo GYM
GYM_LEMA=Tu gimnasio en Puebla, en tres sucursales.
GYM_DESCRIPCION=
GYM_ACENTO=#F8D048
GYM_CIUDAD=Puebla
